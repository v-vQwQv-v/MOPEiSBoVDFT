{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "RESOURCE_NAME": "IsaacSim",
                "CARB_APP_PATH": "E:/isaac-sim4.5.0-rc.36/kit",
                "ISAAC_PATH": "E:/isaac-sim4.5.0-rc.36",
                "EXP_PATH": "E:/isaac-sim4.5.0-rc.36/apps",
                "PYTHONPATH": "E:/isaac-sim4.5.0-rc.36/site;${env:PYTHONPATH}",
                "KIT_PATH": "E:/isaac-sim4.5.0-rc.36",
                "OMNI_USER_EXTENSIONS": "E:/isaac-sim4.5.0-rc.36/exts"
            },
            "python": "E:/isaac-sim4.5.0-rc.36/kit/python/python.exe",
            "envFile": "${workspaceFolder}/.vscode/.standalone_examples.env",
            // "preLaunchTask": "setup_python_env",
            "args": ["--/persistent/isaac/asset_root/default=\"omniverse://my_server\""],
        },
        {
            "name": "Python: Attach (windows-x86_64/linux-x86_64)",
            "type": "python",
            "request": "attach",
            "port": 3000,
            "host": "127.0.0.1",
        },
        {
            "name": "(windows-x86_64) isaac-sim [release]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "E:/isaac-sim4.5.0-rc.36/kit/kit.exe",
            "args": ["E:/isaac-sim4.5.0-rc.36/apps/isaacsim.exp.full.kit",
                "--ext-folder", "E:/isaac-sim4.5.0-rc.36/apps"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
        },
    ]
}